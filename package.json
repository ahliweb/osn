{
  "name": "osn-informatika-2026",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Curriculum-as-code for the OSN Informatika 2026 operational syllabus: schema, domain model, and rendering pipeline.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test",
    "build": "bun build ./src/index.ts --outdir dist --target bun",
    "validate": "echo \"validate: not yet implemented (see issue #19)\""
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.6",
    "typescript": "^5.5.4"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
